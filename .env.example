# Copy to .env for local development. Replace all change-me values.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
OFFICE_TIMEZONE=Asia/Almaty
PUBLIC_PORT=8080

POSTGRES_DB=aispace
POSTGRES_USER=aispace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aispace:change-me-local-only@postgres:5432/aispace

JWT_SECRET=change-me-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=15

VITE_API_BASE_URL=/api/v1
