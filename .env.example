# Copy to .env for local development. Replace all change-me values.
# Compose reads the values below; it sets APP_HOST, APP_PORT, and DATABASE_URL itself.
APP_ENV=development
APP_LOG_LEVEL=INFO
OFFICE_TIMEZONE=Asia/Almaty
PUBLIC_PORT=8080

POSTGRES_DB=aispace
POSTGRES_USER=aispace
POSTGRES_PASSWORD=change-me-local-only

JWT_SECRET=change-me-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=15

VITE_API_BASE_URL=/api/v1

# Direct backend execution only (not Compose): supply a reachable PostgreSQL URL.
# APP_HOST=127.0.0.1
# APP_PORT=8000
# DATABASE_URL=postgresql+asyncpg://aispace:change-me-local-only@localhost:5432/aispace
